# Auth.js — generate with: openssl rand -base64 32
# Production でもローカルと同じく必須（ホストの Environment Variables に設定）
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Cloud Console に登録する URI ---
# Local:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
# Production (例: https://your-app.vercel.app):
#   Authorized JavaScript origins: https://your-app.vercel.app
#   Authorized redirect URIs:      https://your-app.vercel.app/api/auth/callback/google

# SQLite（ローカル）
# Prisma CLI (.env) は prisma/ 基準で file:./dev.db
# Next.js (.env.local) はプロジェクトルート基準で file:./prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# Production（Vercel など）では SQLite は使えません。
# Neon / Vercel Postgres などの PostgreSQL の接続文字列を設定し、
# prisma/schema.prisma の provider を postgresql に切り替えて migrate してください。
